# copy to deploy/.env and fill in (cp env.example .env). never commit the real file.

# --- api: required outside dev ---
CUSTOCK_JWT_SECRET=change-me-to-64-random-characters
CUSTOCK_UNSUB_SECRET=change-me-to-another-64-random-characters
CUSTOCK_PUBLIC_WEB_URL=https://custock.example.com
CUSTOCK_API_URL=https://api.custock.example.com
CUSTOCK_CORS=https://custock.example.com
# behind our own reverse proxy (caddy or nginx) on the same server
CUSTOCK_TRUSTED_PROXY=1
# bot check for public join pages. without a secret signups are refused, unless
# CUSTOCK_TURNSTILE=off (no bot check on purpose, rate limits still apply)
CUSTOCK_TURNSTILE_SECRET=
CUSTOCK_TURNSTILE=on
# shared by the api and the web in the one container, 32+ random characters. lets the web pass the
# visitor's address on (openssl rand -hex 32)
CUSTOCK_INTERNAL_KEY=

# --- api: who signs tokens. local is the built in login, jwks is the real login server ---
CUSTOCK_AUTH_MODE=local
CUSTOCK_AUTH_JWKS_URL=https://login.example.com/.well-known/jwks.json
CUSTOCK_AUTH_ISSUER=https://login.example.com
CUSTOCK_AUTH_AUDIENCE=custock

# --- api: how messages leave. outbox keeps them in the database (the default). live sends
# them through every channel that is set up below, and needs CUSTOCK_ALLOW_SENDING=yes.
# a channel left empty stays in the outbox. a channel half filled in stops the server. ---
CUSTOCK_TRANSPORT=outbox
CUSTOCK_ALLOW_SENDING=no
# web push to the installed web app. make a pair with: pnpm --filter @custock/api vapid
CUSTOCK_VAPID_PUBLIC_KEY=
CUSTOCK_VAPID_PRIVATE_KEY=
CUSTOCK_VAPID_SUBJECT=mailto:you@example.com
# mail. gmail: the @ in the user as %40, the 16 letter app password without spaces
#   CUSTOCK_SMTP_URL=smtps://name%40gmail.com:apppassword@smtp.gmail.com:465
#   CUSTOCK_MAIL_FROM=name@gmail.com
CUSTOCK_SMTP_URL=
CUSTOCK_MAIL_FROM=
# firebase, only for a native phone app. the web app does not need it
CUSTOCK_FCM_SERVICE_ACCOUNT=

# --- api: first start only, puts the made up Lemoni business in an empty database ---
CUSTOCK_SEED=0
CUSTOCK_DEV=0

# --- photos: an S3 compatible bucket, Cloudflare R2 or AWS S3. without these the server refuses
# uploads. CUSTOCK_STORAGE=local keeps them on the server's disk instead, only on purpose.
# the bucket needs a CORS rule for PUT from the web origin, see apps/api/README.md ---
# any CUSTOCK_S3_* value turns s3 on, and then all but the endpoint must be there
CUSTOCK_STORAGE=
# region: auto for R2 (endpoint https://ACCOUNT_ID.r2.cloudflarestorage.com), the region for AWS (no endpoint)
CUSTOCK_S3_BUCKET=
CUSTOCK_S3_REGION=
CUSTOCK_S3_ENDPOINT=
CUSTOCK_S3_ACCESS_KEY_ID=
CUSTOCK_S3_SECRET_ACCESS_KEY=
# where photos are read from: the r2.dev address, a custom domain, or https://BUCKET.s3.REGION.amazonaws.com
CUSTOCK_S3_PUBLIC_URL=

# the photo storage free tier the platform screens measure against, and where uploads stop (95%)
# when "stop uploads at the free limit" is on. defaults: the R2 free tier
CUSTOCK_STORAGE_FREE_BYTES=10000000000
CUSTOCK_STORAGE_FREE_WRITES=1000000

# --- litestream: an S3 compatible bucket (Cloudflare R2) ---
LITESTREAM_BUCKET=custock-backups
LITESTREAM_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
